# =========================================================
# 회사 공용 브레인 — 환경 변수 예시
# 사용법: cp .env.example .env 후 값 채우기
# ⚠️ .env 는 절대 Git에 올리지 말 것 (.gitignore 확인)
# =========================================================

# ---------- 앱 ----------
APP_ENV=
APP_DEBUG=
APP_NAME=
CORS_ORIGINS=

# ---------- PostgreSQL + pgvector ----------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
DATABASE_URL=

# ---------- Redis / Celery ----------
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ---------- 인증 ----------
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=
MCP_TOKEN_PREFIX=

# ---------- 파일 저장소 (S3) ----------
STORAGE_BACKEND=
LOCAL_STORAGE_DIR=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_TMP_PREFIX=

# ---------- 업로드 제한 (SUB-02) ----------
UPLOAD_MAX_SIZE_MB=
ALLOWED_EXTENSIONS=

# ---------- LLM ----------
# 제공사·모델은 비교 실험(EXP-01) 후 확정
LLM_PROVIDER=
LLM_API_KEY=
LLM_FLAGSHIP_MODEL=
LLM_SUMMARY_MODEL=
LLM_TIMEOUT_SECONDS=

# 경량 판정 (Decisions API, GPT-6 Luna)
DECISIONS_API_KEY=
DECISIONS_MODEL=

# 판정 어댑터 선택 (IMP-05): rule | logreg | luna | flagship
JUDGE_BACKEND=

# ---------- 임베딩 (CHG-05) ----------
EMBEDDING_MODEL=
EMBEDDING_DEVICE=
EMBEDDING_DIM=

# ---------- Langfuse (OPS-05, 자체 호스팅) ----------
LANGFUSE_ENABLED=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- 알림 (NTF-07) ----------
REMIND_AFTER_HOURS=
REMIND_CHECK_INTERVAL_MINUTES=
