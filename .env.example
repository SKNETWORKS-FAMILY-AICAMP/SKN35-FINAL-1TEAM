# =========================================================
# 회사 공용 브레인 — 환경 변수 예시
# 사용법: cp .env.example .env 후 값 채우기
# ⚠️ .env 는 절대 Git에 올리지 말 것 (.gitignore 확인)
# =========================================================

# ---------- 앱 ----------
APP_ENV=local                      # local | dev | prod
APP_DEBUG=true
APP_NAME=company-brain
CORS_ORIGINS=http://localhost:5173 # 프론트(Vite) 주소, 여러 개면 콤마로 구분

# ---------- PostgreSQL + pgvector ----------
POSTGRES_USER=brain
POSTGRES_PASSWORD=change-me
POSTGRES_DB=company_brain
POSTGRES_HOST=localhost            # docker-compose 내부에서 실행 시: postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://brain:change-me@localhost:5432/company_brain

# ---------- Redis / Celery ----------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------- 인증 ----------
JWT_SECRET_KEY=change-me-to-random-string   # 생성: openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MCP_TOKEN_PREFIX=cb_                         # MCP 개인 토큰 접두어 (MCP-05)

# ---------- 파일 저장소 (S3) ----------
STORAGE_BACKEND=s3                 # s3 | local (로컬 개발용)
LOCAL_STORAGE_DIR=./.storage       # STORAGE_BACKEND=local 일 때만 사용
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=company-brain-dev
S3_TMP_PREFIX=tmp/                 # 임시 업로드 경로 (OPS-02)

# ---------- 업로드 제한 (SUB-02) ----------
UPLOAD_MAX_SIZE_MB=30              # 배포 후 측정값으로 조정
ALLOWED_EXTENSIONS=pdf,docx,pptx,hwpx,xlsx,md,txt

# ---------- LLM ----------
# 제공사·모델은 비교 실험(EXP-01) 후 확정
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_FLAGSHIP_MODEL=                # 판정·답변 생성용 플래그십 모델
LLM_SUMMARY_MODEL=                 # 3줄 요약용 (NTF-02)
LLM_TIMEOUT_SECONDS=30

# 경량 판정 (Decisions API, GPT-6 Luna)
DECISIONS_API_KEY=
DECISIONS_MODEL=

# 판정 어댑터 선택 (IMP-05): rule | logreg | luna | flagship
JUDGE_BACKEND=flagship

# ---------- 임베딩 (CHG-05) ----------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu               # cpu | cuda | mps(맥 로컬)
EMBEDDING_DIM=1024

# ---------- Langfuse (OPS-05, 자체 호스팅) ----------
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- 알림 (NTF-07) ----------
REMIND_AFTER_HOURS=48
REMIND_CHECK_INTERVAL_MINUTES=60
